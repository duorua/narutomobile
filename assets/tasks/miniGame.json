                        "mini_game": {
                            "next": "find_bonds"
                        }
                    }
                }
            ]
        },
        "忍道交锋刷什么": {
            "type": "select",
            "default_case": "4倍S箱",
            "description": "要刷的箱子等级,遇到低于期望等级的箱子会刷新",
            "cases": [
                {
                    "name": "4倍S箱",
                    "pipeline_override": {
                        "nindao_clash_check_recognition_area": {
                            "next": [
                                "[JumpBack]nindao_clash_get_award",
                                "nindao_clash_gold_4",
                                "nindao_clash_gold_8",
                                "[JumpBack]nindao_clash_refresh",
                                "nindao_clash_without_red_point",
                                "[JumpBack]nindao_clash_anime_on"
                            ]
                        }
                    }
                },
                {
                    "name": "A箱子",
                    "pipeline_override": {
                        "nindao_clash_check_recognition_area": {
                            "next": [
                                "[JumpBack]nindao_clash_get_award",
                                "nindao_clash_mid",
                                "nindao_clash_gold_4",
                                "nindao_clash_gold_8",
                                "[JumpBack]nindao_clash_refresh",
                                "nindao_clash_without_red_point",
                                "[JumpBack]nindao_clash_anime_on"
                            ]
                        }
                    }
                },
                {
                    "name": "最逊的那个",
                    "pipeline_override": {
                        "nindao_clash_check_recognition_area": {
                            "next": [
                                "[JumpBack]nindao_clash_get_award",
                                "nindao_clash_low",
                                "nindao_clash_mid",
                                "nindao_clash_gold_4",
                                "nindao_clash_gold_8",
                                "[JumpBack]nindao_clash_refresh",
                                "nindao_clash_without_red_point",
                                "[JumpBack]nindao_clash_anime_on"
                            ]
                        }
                    }
                }
            ]
        },
        "羁绊追寻自动退出": {
            "type": "switch",
            "default_case": "No",
            "description": "羁绊追寻剩余数字离图片太近不好识别,建议关闭自动退出",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "find_bonds_card_flip_loop": {
                            "next": [
                                "find_bonds_card_flip_win",
                                "[JumpBack]find_bonds_card_flip_loop"
                            ]
                        },
                        "find_bonds_card_flip_start": {
                            "next": [
                                "find_bonds_card_flip_loop"
                            ]
                        },
                        "find_bonds_without_card_flip_win": {
                            "next": [
                                "find_bonds_card_flip_loop"
                            ]
                        }
                    }
                },
                {
                    "name": "Yes"
                }
            ]
        },
        "木叶小吃店不选蓝红色奖励": {
            "type": "switch",
            "default_case": "No",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "konoha_snack_mid": {
                            "enabled": false
                        },
                        "konoha_snack_high": {
                            "enabled": false
                        }
                    }
                }
            ]
        }
    }
}
