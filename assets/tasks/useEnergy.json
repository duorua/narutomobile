{
    "task": [
        {
            "name": "刷体力",
            "entry": "use_energy",
            "default_check": true,
            "group": [
                "daily"
            ],
            "option": [
                "刷体力方式"
            ]
        }
    ],
    "option": {
        "刷体力方式": {
            "type": "select",
            "cases": [
                {
                    "name": "精英副本",
                    "option": ["精英副本策略"]
                },
                {
                    "name": "做装备",
                    "description": "测试功能;通过做装备刷体力,还没适配超影服务;最好先了解战力玩法,一般只在老登或买体力时使用这个功能",
                    "option": [
                        "做什么装备"
                    ],
                    "pipeline_override": {
                        "use_energy": {
                            "next": "use_energy_forge_gear"
                        }
                    }
                },
                {
                    "name": "修罗副本",
                    "description": "测试功能;最好先了解战力玩法,一般只在老登或买体力时使用这个功能",
                    "pipeline_override": {
                        "use_energy": {
                            "next": "asura_instance"
                        },
                        "advanture_check_no_next_roll": {
                            "next": [
                                "check_sweep_level",
