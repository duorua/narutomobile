{
    "task": [
        {
            "name": "要塞",
            "entry": "stronghold",
            "description": "请不要手动拖动地图,可能导致无法移动到要塞区域;可进对应要塞内开始任务;不能挂跨服",
            "group": [
                "weekly"
            ],
            "option": [
                "要塞玩法未开启时退出",
                "指定要塞",
                "忍界指引寻找要塞",
                "串行连点器(beta)"
            ]
        }
    ],
    "option": {
        "要塞玩法未开启时退出": {
            "type": "switch",
            "description": "如果关闭会在组织界面一直尝试进入对应功能",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "stronghold_mode": {
                            "max_hit": 5
                        }
                    }
                },
