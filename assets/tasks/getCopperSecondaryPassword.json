{
    "task": [
        {
            "name": "铜币招财[二级密码](beta)",
            "entry": "get_copper",
            "description": "<font color=\"tomato\">需要二级密码,你需要非常小心,MaaAutoNaruto不会对任何损失负责</font>",
            "group": [
                "daily"
            ],
            "option": [
                "金币招财",
                "按轮招财",
                "按次招财"
            ]
        }
    ],
    "option": {
        "金币招财": {
            "type": "select",
            "description": "这个选项不需要选择;选项需要二级密码,你需要非常小心,MaaAutoNaruto不会对任何损失负责",
            "cases": [
                {
                    "name": "开",
                    "pipeline_override": {
                        "check_free_copper_done": {
                            "next": "get_copper_with_secondary_password"
                        },
                        "get_copper": {
                            "next": [
                                "get_copper_in_main_screen",
                                "[JumpBack]back_main_screen_before_task"
                            ]
                        }
                    }
                }
            ],
            "default_case": "开"
        },
        "按轮招财": {
            "type": "switch",
            "description": "会先执行按轮招财,再执行按次招财",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "招财轮次"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "get_copper_by_roll": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "招财轮次": {
            "type": "input",
            "description": "招财轮次设置",
            "inputs": [
                {
                    "name": "招财轮次",
                    "label": "招财轮次",
                    "description": "输入需要的招财轮数,最大10",
                    "default": "1",
                    "pipeline_type": "string",
                    "verify": "^([1-9]|10)$"
                }
            ],
            "pipeline_override": {
                "check_get_copper_by_roll": {
                    "custom_recognition_param": {
                        "count": "{招财轮次}"
                    }
                }
            }
        },
        "按次招财": {
            "type": "switch",
            "description": "会先执行按轮招财,再执行按次招财",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "get_copper_by_count": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes",
                    "option": [
                        "招财次数"
                    ]
                }
            ],
            "default_case": "No"
        },
        "招财次数": {
            "type": "input",
            "description": "招财轮次设置",
            "inputs": [
                {
                    "name": "招财次数",
                    "label": "招财次数",
                    "description": "输入需要的最后一轮的招财次数,最大10",
                    "default": "1",
                    "pipeline_type": "string",
                    "verify": "^([1-9]|10)$"
                }
            ],
            "pipeline_override": {
                "check_get_copper_by_count": {
                    "custom_recognition_param": {
                        "count": "{招财次数}"
                    }
                }
            }
        }
    }
}
