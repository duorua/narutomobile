                {
                    "name": "问答游戏(挂机)",
                    "pipeline_override": {
                        "mini_game": {
                            "next": "konoha_question_and_answer"
                        }
                    }
                },
                {
                    "name": "忍道交锋(beta)",
                    "description": "刷不出来8个S箱",
