{
    "task": [
        {
            "name": "小游戏",
            "entry": "mini_game",
            "option": [
                "选择小游戏"
            ],
            "group": [
                "event"
            ],
            "description": "小游戏可以主页进,也可以从有小游戏名的功能入口界面进"
        }
    ],
    "option": {
        "选择小游戏": {
            "type": "select",
            "default_case": "速战速决",
            "description": "请尽量不要滥用这个功能影响其他人游戏体验",
            "cases": [
                {
                    "name": "速战速决",
                    "pipeline_override": {
                        "mini_game": {
                            "next": "blitz"
                        }
                    }
                },
                {
                    "name": "夏日回馈(beta)",
                    "description": "不会选择,只会签到",
                    "pipeline_override": {
                        "mini_game": {
                            "next": "summer_plan"
                        }
                    }
                },

                {
                    "name": "送好礼摇铃",
                    "description": "不会选择,只会签到",
                    "pipeline_override": {
                        "mini_game": {
                            "next": "fine_gift_bell"
                        }
                    }
                },
                {
                    "name": "奥义图大富翁(beta)",
                    "description": "请在[送奥义]界面开启,不会自动领取宝箱和做网页活动",
                    "pipeline_override": {
                        "mini_game": {
                            "next": "get_aoyi_picture"
                        }
                    }
                },
                {
                    "name": "冠军送礼",
                    "option": [
                        "忍界指引寻找冠军送礼"
                    ],
                    "pipeline_override": {
