                                "use_energy_check_not_one_key_select",
                                "[JumpBack]use_energy_ez_sweep_entry"
                            ]
                        }
                    }
                },
                {
                    "name": "自定义筛选",
                    "option": [
                        "精英副本等级筛选",
                        "精英副本星级筛选"
