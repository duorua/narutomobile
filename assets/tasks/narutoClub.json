{
    "task": [
        {
            "name": "火影情报社(beta)",
            "entry": "naruto_club",
            "option": [
                "跳过情报社点赞",
                "喂豚豚",
                "金币助手",
                "情报社卡顿模式"
            ],
            "group": [
                "daily"
            ],
            "default_check": true,
            "description": "该任务并不稳定,如遇卡顿可能需要人工接管;确认MFA不会在喂豚豚和金币助手闪退后开启再对应选项,闪退bug成因还在寻找"
        }
    ],
    "option": {
        "跳过情报社点赞": {
            "type": "switch",
            "default_case": "No",
            "description": "在打满包括周胜的日常任务的时候活跃度正好够100,可以开启这个选项节省时间",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "club_like_mission": {
                            "next": [
                                "close_surf_post",
                                "scroll",
                                "club_like_mission"
                            ]
                        }
                    }
                }
            ]
        },
        "喂豚豚": {
            "type": "switch",
            "default_case": "No",
            "description": "确认MFA不会在喂豚豚闪退后开启,闪退bug成因还在寻找",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "feed_pig": {
                            "enabled": false
                        },
                        "without_feed_pig": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes"
                }
            ]
        },
        "金币助手": {
            "type": "switch",
            "default_case": "No",
            "description": "确认MFA不会在金币助手闪退后开启,闪退bug成因还在寻找",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "check_club_mission_done": {
                            "next": [
                                "club_third_award_done",
                                "benefit_station",
                                "swipe_for_club_submit"
                            ]
                        }
                    }
                },
                {
                    "name": "Yes"
                }
            ]
        },
        "情报社卡顿模式": {
            "type": "switch",
            "default_case": "No",
            "description": "如果情报社非常容易卡,那么请开启这个选项",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "club_submit": {
                            "post_wait_freezes": 1000
                        }
                    }
                }
            ]
        }
    }
}
