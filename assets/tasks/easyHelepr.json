{
    "task": [
        {
            "name": "轻松助手",
            "entry": "easy_helper",
            "option": [
                "轻松助手扫荡",
                "秘境翻饰品牌",
                "秘境翻忍具牌",
                "秘境忍具每次只翻一张",
                "轻松助手小队突袭四倍奖励"
