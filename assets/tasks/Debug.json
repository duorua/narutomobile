{
    "task": [
        {
            "name": "Debug",
            "entry": "debug",
            "description": "用于调试，<b>日常使用请勿开启！</b>",
            "group": [
                "external"
            ],
            "option": [
                "display_pointer_location",
                "display_touch"
            ]
        }
    ],
    "option": {
        "display_pointer_location": {
            "type": "switch",
            "description": "<b>WARNING!</b> The position top bar may invalidate the close button for some windows.",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "show_pointer_location": {
                            "enabled": true
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "display_touch": {
            "type": "switch",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "show_touches": {
                            "enabled": true
                        }
                    }
                }
            ],
            "default_case": "No"
        }
    }
}
