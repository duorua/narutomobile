{
    // 页面状态识别的探针节点：只作为 run_recognition 的 override 容器，不被任何 next 引用。
    // 故意不写 recognition，避免 override 合并后残留 DirectHit 导致探针恒命中。
    "page_state_probe": {
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 3000
    },
    "in_ninja_guide": {
        "recognition": "Or",
        "any_of": [
            {
                "sub_name": "mission_label",
                "recognition": "OCR",
                "roi": [
                    968,
                    68,
                    307,
                    100
                ],
                "expected": [
                    "任务"
                ]
            },
            {
                "sub_name": "returning_player",
                "recognition": "OCR",
                "roi": [
                    0,
                    0,
                    195,
                    285
                ],
                "expected": [
                    "回流"
                ]
            }
        ]
    },
    // 获取带有数字的文本
    "GetTextWithNumers": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "\\d+"
            }
        }
    },
    "custom_ocr": {
        "recognition": {
            "type": "OCR",
            "param": {
                "replace": [
                    [
                        "丑",
                        "忍"
                    ],
                    [
                        "双",
                        "忍"
                    ],
                    [
                        "米",
                        "术"
                    ],
                    [
                        "\\(",
                        "（"
                    ],
                    [
                        "D",
                        "0"
                    ]
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 0
    },
    "card_wait": {
        "recognition": "TemplateMatch",
        "template": [
            "Find_bonds/未翻开.png"
        ]
    },
    "card_0": {
        "recognition": "TemplateMatch",
        "template": [
            "Find_bonds/紫色牌.png"
        ]
    },
    "card_1": {
        "recognition": "TemplateMatch",
        "template": [
            "Find_bonds/橙色牌.png"
        ]
    }
}
