                        }
                    }
                },
                {
                    "name": "抢红包",
                    "pipeline_override": {
                        "mini_game": {
                            "next": "red_envelope"
                        }
                    }
                },
                {
                    "name": "木叶小吃店",
                    "option": [
                        "木叶小吃店不选蓝红色奖励"
                    ],
                    "pipeline_override": {
                        "mini_game": {
                            "next": "konoha_snack_shop"
                        }
                    }
                },
                {
                    "name": "决斗场托管一把",
                    "pipeline_override": {
                        "mini_game": {
                            "timeout": 10000,
                            "next": "weekly_win_match_fighting"
