{
    "task": [
        {
            "name": "秘境",
            "entry": "secret_realm",
            "default_check": true,
            "description": "请在主页开始任务,连点器任务可能不兼容**雷电模拟器**",
            "group": [
                "daily"
            ],
            "option": [
                "秘境赢几次",
                "秘境翻饰品牌",
                "秘境翻忍具牌",
                "秘境忍具每次只翻一张",
                "从奖励中心进入",
                "有挑战卷的时候才挑战",
                "烈炎秘境",
                "罡体秘境",
                "水牢秘境",
                "落岩秘境",
                "毒风秘境",
                "雷霆秘境",
                "阴阳秘境",
                "串行连点器(beta)",
                "忍界指引寻找秘境"
            ]
        }
    ],
    "option": {
        "秘境赢几次": {
            "type": "input",
            "description": "秘境胜利次数设置",
            "inputs": [
                {
                    "name": "秘境胜利次数",
                    "label": "秘境胜利次数",
                    "description": "输入需要的胜利次数,最大999",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d{0,2}$"
                }
            ],
            "pipeline_override": {
                "secret_realm_check_overflow": {
                    "custom_recognition_param": {
                        "max_hit": "{秘境胜利次数}"
                    }
                }
            }
        },
        "秘境翻饰品牌": {
            "type": "switch",
            "description": "确认有足够的秘境饰品翻牌卷,不要关闭二级密码,否则这个选项会消耗大量金币",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "secret_realm_flip_has_accessory_card": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "secret_realm_win": {
                            "action": "DoNothing"
                        },
                        "secret_realm_flip_without_card": {
                            "enabled": true
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "秘境翻忍具牌": {
            "type": "switch",
            "description": "确认有足够的秘境忍具翻牌卷,不要关闭二级密码,否则这个选项会消耗巨量金币",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "secret_realm_gear_card": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "secret_realm_win": {
                            "action": "DoNothing"
                        },
                        "secret_realm_flip_without_card": {
                            "enabled": true
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "秘境忍具每次只翻一张": {
            "type": "switch",
            "description": "性价比选项,只有开启了翻忍具牌选项才生效",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "secret_realm_win": {
                            "next": [
                                "secret_realm_fight",
                                "secret_realm_flip_without_card",
                                "[JumpBack]secret_realm_flip_has_accessory_card",
                                "secret_realm_gear_card",
                                "secret_realm_celebreate",
                                "secret_realm_celebreate_1",
                                "[JumpBack]secret_realm_win",
                                "secret_realm_check_in_main"
                            ]
                        },
                        "secret_realm_flip_gear_card": {
                            "next": [
                                "secret_realm_win_back_secret_realm",
                                "secret_realm_celebreate",
                                "secret_realm_celebreate_1"
                            ]
                        }
                    }
                },
                {
                    "name": "No"
                }
            ],
            "default_case": "Yes"
        },
        "有挑战卷的时候才挑战": {
            "type": "switch",
            "description": "在有挑战卷的时候才进行秘境挑战,关闭可能会在没有挑战卷进入秘境的时候卡死",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "secret_realm_fight": {
                            "action": "DoNothing",
                            "next": [
                                "secret_realm_check_ticket",
                                "secret_realm_last_end"
                            ]
                        }
                    }
                },
                {
                    "name": "No"
                }
            ],
            "default_case": "Yes"
        },
        "烈炎秘境": {
            "type": "switch",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "secret_realm_fire": {
                            "next": [
                                "secret_realm_in_fight"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "secret_realm_fire": {
                            "next": [
                                "secret_realm_quit"
                            ]
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "罡体秘境": {
            "type": "switch",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "secret_realm_body": {
                            "next": [
                                "secret_realm_in_fight"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "secret_realm_body": {
                            "next": [
                                "secret_realm_quit"
                            ]
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "水牢秘境": {
            "type": "switch",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "secret_realm_water": {
                            "next": [
                                "secret_realm_water_to_place"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "secret_realm_water": {
                            "next": [
                                "secret_realm_quit"
                            ]
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "落岩秘境": {
            "type": "switch",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "secret_realm_rock": {
                            "next": [
                                "secret_realm_quit"
                            ]
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "secret_realm_rock": {
                            "next": [
                                "secret_realm_rock_to_place"
                            ]
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "毒风秘境": {
            "type": "switch",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "secret_realm_toxic_wind": {
                            "next": [
                                "secret_realm_quit"
                            ]
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "secret_realm_toxic_wind": {
                            "next": [
                                "secret_realm_toxic_wind_to_place"
                            ]
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "雷霆秘境": {
            "type": "switch",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "secret_realm_thunder": {
                            "next": [
                                "secret_realm_quit"
                            ]
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "secret_realm_thunder": {
                            "next": [
                                "secret_realm_thunder_to_place"
                            ]
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "阴阳秘境": {
            "type": "switch",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "secret_realm_yin_yang": {
                            "next": [
                                "secret_realm_quit"
                            ]
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "secret_realm_yin_yang": {
                            "next": [
                                "secret_realm_yin_yang_to_place"
                            ]
                        }
                    }
                }
            ],
            "default_case": "No"
        }
    }
}
