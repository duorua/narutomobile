{
    "task": [
        {
            "name": "解锁二级密码",
            "entry": "secondary_password_open",
            "option": [
                "二级密码",
                "买体力触发二级密码"
            ],
            "group": [
                "daily",
                "redeem",
                "weekly"
            ],
            "description": "开启后会输入二级密码[size:15][color:tomato]需要二级密码,你需要非常小心,MaaAutoNaruto不会对任何损失负责[/color][/size]"
        }
    ],
    "option": {
        "二级密码": {
            "type": "input",
            "description": "开启二级密码之后可能出现误使用金币的情况,请自己注意避免,建议将需要二级密码的任务放到最后执行",
            "inputs": [
                {
                    "name": "二级密码",
                    "label": "二级密码",
                    "pipeline_type": "string",
                    "password": true,
                    "verify": "^(0|\\d{6})$"
                }
            ],
            "pipeline_override": {
                "input_secondary_password": {
                    "input_text": "{二级密码}"
                },
                "check_secondary_password": {
                    "expected": [
                        "{二级密码}"
                    ]
                },
                "secondary_password_clear": {
                    "custom_action_param": {
                        "psd": "{二级密码}"
                    }
                }
            }
        },
        "买体力触发二级密码": {
            "type": "switch",
            "default_case": "No",
            "description": "新号没有聊天,用买体力触发,不要再满体力和特别卡的时候用",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "secondary_password_open": {
                            "next": [
                                "buy_energy_in_main_screen",
                                "[JumpBack]back_main_screen_before_task"
                            ]
                        },
                        "check_not_in_buy_energy": {
                            "next": [
                                "[JumpBack]energy_upper_limit",
                                "secondary_password",
                                "[JumpBack]pay_to_stronger_tip",
                                "back_main_screen_and_stop"
                            ]
                        }
                    }
                }
            ]
        }
    }
}
