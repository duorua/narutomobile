            "group": [
                "event"
            ]
        }
    ],
    "option": {
        "轻松助手扫荡": {
            "type": "switch",
            "description": "轻松助手秘境,小队扫荡",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "secret_realm_celebreate": {
                            "next": [
                                "secret_realm_celebreate",
                                "secret_realm_celebreate_1",
                                "easy_helper_sweep"
                            ]
                        },
                        "secret_realm_celebreate_1": {
                            "next": [
                                "secret_realm_celebreate",
                                "secret_realm_celebreate_1",
                                "easy_helper_sweep"
                            ]
                        },
                        "secret_realm_win": {
                            "next": [
                                "secret_realm_fight",
                                "secret_realm_flip_without_card",
                                "[JumpBack]secret_realm_flip_has_accessory_card",
                                "[JumpBack]secret_realm_gear_card",
                                "secret_realm_celebreate",
                                "secret_realm_celebreate_1",
                                "[JumpBack]secret_realm_win",
                                "secret_realm_check_in_main"
                            ]
                        },
                        "secret_realm_check_in_main": {
                            "next": [
                                "easy_helper_enter",
                                "easy_helper_done",
                                "[JumpBack]back_main_screen"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "easy_helper_log_on_award_done": {
                            "next": [
                                "back_main_screen_and_stop"
                            ]
                        },
                        "get_easy_helper_without_log_on_award": {
                            "next": [
                                "back_main_screen_and_stop"
                            ]
                        }
                    }
                }
            ]
        },
        "轻松助手小队突袭四倍奖励": {
            "type": "switch",
            "default_case": "No",
            "description": "选项需要二级密码,你需要非常小心,MaaAutoNaruto不会对任何损失负责",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "check_no_easy_helper_sweep": {
                            "next": [
                                "easy_helper_team_dash_sweep_check_4x",
                                "easy_helper_team_dash_sweep_checked_4x"
                            ]
                        },
                        "easy_helper_can_not_sweep": {
                            "next": [
                                "easy_helper_team_dash_sweep_check_4x",
                                "easy_helper_team_dash_sweep_checked_4x"
                            ]
                        }
                    }
                }
            ]
        }
    }
